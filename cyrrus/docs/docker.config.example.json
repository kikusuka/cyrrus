{
  "provider": {
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4o-mini",
    "api_key_env": "OPENAI_API_KEY"
  },
  "memory": {
    "db_path": "/data/memory.sqlite"
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 8787,
    "mode": "inject",
    "session": "default",
    "api_key_env": "CYRRUS_GATEWAY_TOKEN"
  }
}
